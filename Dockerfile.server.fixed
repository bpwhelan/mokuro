# Multi-stage build for mokuro-server with full OCR support
# Stage 1: Builder stage for dependencies
FROM ubuntu:noble AS builder

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV NODE_MAJOR=20

# Install system dependencies and build tools
RUN apt-get update && apt-get install -y \
    # Python and build essentials
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    build-essential \
    git \
    wget \
    curl \
    ca-certificates \
    gnupg \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # Additional libraries for image processing
    libwebp-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    # Chrome dependencies for chrome-lens-ocr
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    # Additional Chrome dependencies
    libx11-6 \
    libxcb1 \
    libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (latest LTS)
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel setuptools

# Set working directory
WORKDIR /app

# Copy project files first (for better caching)
COPY pyproject.toml setup.py* ./
COPY mokuro/_version.py mokuro/_version.py
COPY README.md LICENSE ./

# Install Python dependencies
COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt

# Copy the rest of the application
COPY . .

# Initialize git submodules
RUN git init && \
    git submodule add https://github.com/dmMaze/comic-text-detector.git comic_text_detector || true && \
    git submodule update --init --recursive || true

# Install Node.js dependencies
RUN npm install

# Pre-download models to speed up container startup
RUN python3 -c "from mokuro.cache import cache; cache.comic_text_detector" || true

# Pre-download manga-ocr model
RUN python3 -c "from manga_ocr import MangaOcr; MangaOcr()" || true

# Stage 2: Runtime stage
FROM ubuntu:noble

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"
ENV NODE_MAJOR=20

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    # Python runtime
    python3 \
    # Git (needed for version info)
    git \
    # OpenCV runtime
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    # Image format support (runtime libraries)
    libwebp7 \
    libjpeg8 \
    libpng16-16t64 \
    libtiff6 \
    # Chrome runtime dependencies for chrome-lens-ocr
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    wget \
    curl \
    ca-certificates \
    gnupg \
    # Additional Chrome dependencies
    libx11-6 \
    libxcb1 \
    libx11-xcb1 \
    # For health checks
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js runtime
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Copy application from builder
WORKDIR /app
COPY --from=builder /app .

# Copy pre-downloaded models from builder
COPY --from=builder /root/.cache /root/.cache

# Create necessary directories
RUN mkdir -p /tmp/mokuro_api \
    && mkdir -p /app/cache \
    && mkdir -p /app/logs

# Create non-root user for security
RUN useradd -m -u 1000 mokuro && \
    chown -R mokuro:mokuro /app /tmp/mokuro_api /root/.cache

# Switch to non-root user
USER mokuro

# Expose port
EXPOSE 7331

# Environment variables with defaults
ENV MOKURO_HOST=0.0.0.0
ENV MOKURO_PORT=7331
ENV MOKURO_PRELOAD_MODELS=true
ENV MOKURO_LOG_LEVEL=INFO
ENV MOKURO_MAX_WORKERS=4

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${MOKURO_PORT}/health || exit 1

# Copy and set up entrypoint script
COPY --chown=mokuro:mokuro docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Run the server
ENTRYPOINT ["/app/docker-entrypoint.sh"]