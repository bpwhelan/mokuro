# syntax=docker/dockerfile:1
# Debian 13 (trixie) CPU-only image with full codecs and libjxl built from source
FROM debian:trixie-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

# Base system + Python + build tools (size not a concern)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git \
    python3 python3-pip python3-venv python3-dev \
    build-essential pkg-config cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

# System deps for image codecs, Pillow/HEIF/JXL plugins, and OpenCV runtime
# Include common X/GL libs used by opencv-python wheels
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libgl1 \
      libglib2.0-0 \
      libsm6 \
      libxext6 \
      libxrender1 \
      libx11-6 \
      libjpeg62-turbo \
      libpng16-16 \
      libtiff6 \
      libwebp7 \
      libheif1 \
      libgomp1 \
      ffmpeg \
      unzip \
    && rm -rf /var/lib/apt/lists/*

# Build and install libjxl from source to guarantee presence
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git \
        libbrotli-dev \
        libgif-dev \
        libjpeg-dev \
        libpng-dev \
        libwebp-dev \
        libtiff-dev \
        libopenexr-dev \
        liblcms2-dev \
        libzstd-dev; \
    rm -rf /var/lib/apt/lists/*; \
    git clone --depth 1 --recursive https://github.com/libjxl/libjxl.git /tmp/libjxl; \
    mkdir -p /tmp/libjxl/build && cd /tmp/libjxl/build; \
    cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DJPEGXL_ENABLE_TOOLS=OFF -DJPEGXL_WARNINGS_AS_ERRORS=OFF ..; \
    ninja -j"$(nproc)"; \
    ninja install; \
    ldconfig; \
    rm -rf /tmp/libjxl

WORKDIR /app

# Copy project
COPY pyproject.toml README.md LICENSE /app/
COPY mokuro /app/mokuro
COPY comic_text_detector /app/comic_text_detector

# Install the package with API + engines + image plugins
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir \
      ".[api,owocr]"

# Create non-root user
RUN useradd -m -u 10001 appuser
USER appuser

EXPOSE 7331

# Default server settings
ENV MOKURO_API_HOST=0.0.0.0 \
    MOKURO_API_PORT=7331

ENTRYPOINT ["mokuro-api"]
