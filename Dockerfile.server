# Multi-stage build for mokuro-server with full OCR support
# Stage 1: Builder stage for dependencies
FROM ubuntu:noble AS builder

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install minimal system dependencies first
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    build-essential \
    git \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel setuptools

# Install additional build dependencies for Python packages
RUN apt-get update && apt-get install -y \
    pkg-config \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgthread-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files first (for better caching)
COPY pyproject.toml setup.py* ./
COPY mokuro/_version.py mokuro/_version.py
COPY README.md LICENSE ./

# Install Python dependencies
COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt

# Copy the rest of the application
COPY . .

# Initialize git submodules if needed
RUN if [ -f .gitmodules ]; then \
        git init && \
        git submodule update --init --recursive || true; \
    fi

# Install Node.js dependencies
RUN npm install || true

# Pre-download models to speed up container startup
RUN python3 -c "from mokuro.cache import cache; cache.comic_text_detector" || true
RUN python3 -c "from manga_ocr import MangaOcr; MangaOcr()" || true

# Stage 2: Runtime stage
FROM ubuntu:noble

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    git \
    curl \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgthread-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Copy application from builder
WORKDIR /app
COPY --from=builder /app .

# Copy pre-downloaded models from builder
COPY --from=builder /root/.cache /root/.cache

# Create necessary directories
RUN mkdir -p /tmp/mokuro_api \
    && mkdir -p /app/cache \
    && mkdir -p /app/logs

# Create non-root user for security (use UID 1001 to avoid conflicts)
RUN useradd -m -u 1001 mokuro && \
    chown -R mokuro:mokuro /app /tmp/mokuro_api /root/.cache

# Switch to non-root user
USER mokuro

# Expose port
EXPOSE 7331

# Environment variables with defaults
ENV MOKURO_HOST=0.0.0.0
ENV MOKURO_PORT=7331
ENV MOKURO_PRELOAD_MODELS=true
ENV MOKURO_LOG_LEVEL=INFO
ENV MOKURO_MAX_WORKERS=4

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${MOKURO_PORT}/health || exit 1

# Copy and set up entrypoint script
COPY --chown=mokuro:mokuro docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Run the server
ENTRYPOINT ["/app/docker-entrypoint.sh"]